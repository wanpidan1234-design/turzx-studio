{
  "$meta": { "name": "TURZX Studio UI tokens", "version": "1.0", "date": "2026-11-13", "units": "px" },
  "font": {
    "family": { "base": "Inter, 'Noto Sans SC', 'PingFang SC', sans-serif" },
    "numeric": "font-variant-numeric: tabular-nums",
    "display": {
      "hero":      { "size": 232, "weight": 300, "lineHeight": 0.92, "use": "S03 时钟、S04 倒计时" },
      "metricXL":  { "size": [168, 184], "weight": 600, "lineHeight": 0.95, "use": "S01 CPU" },
      "metricL":   { "size": [72, 96], "weight": 600, "lineHeight": 1.0, "use": "S07 / S08 单账号窗口、S02 速率" },
      "metricM":   { "size": [34, 56], "weight": 600, "lineHeight": 1.05, "use": "多账号、OpenAI 次数" },
      "title":     { "size": [26, 40], "weight": 600 },
      "label":     { "size": [20, 24], "weight": [500, 600] },
      "meta":      { "size": [18, 20], "weight": 400, "min": 18 }
    },
    "console": {
      "h1": { "size": 30, "narrow": 22, "weight": 600 },
      "h2": { "size": 15, "weight": 600 },
      "body": { "size": 14, "lineHeight": 1.5 },
      "caption": { "size": 12, "lineHeight": 1.5, "min": 12 }
    }
  },
  "color": {
    "night": { "bg": "#0E1412", "panel": "#121A17", "line": "#24302B", "ink": "#ECF1EC", "ink2": "#A9B6AF", "ink3": "#82918A", "mint": "#8BD3A0", "cyan": "#86C8EA", "amber": "#E7B45A", "warmBg": "#16120F" },
    "cream": { "bg": "#FBF4EC", "card": "rgba(255,252,248,0.90)", "line": "#E8DCCF", "ink": "#2B211C", "ink2": "#6B5A4F", "clay": "#A84B26", "bar": "#C2602F", "track": "#EDE2D6", "out": "#8C2F12", "stale": "#7A6A5E", "staleBar": "#B9A797", "warn": "#8A5A0A", "live": "#2F7A4F", "hatch": "repeating-linear-gradient(135deg,#E3D3C3 0 6px,#F3E9DE 6px 12px)" },
    "mint":  { "bg": "#F3F7F4", "card": "rgba(255,255,255,0.86)", "line": "rgba(19,48,42,0.10)", "ink": "#13302A", "ink2": "#4A6359", "green": "#1D6A4E", "track": "#D6E4DC", "warn": "#8A5A0A", "chip": "#DCEDE3" },
    "ui":    { "bg": "#F5F4F0", "nav": "#F1F0EB", "panel": "#FAF9F6", "surface": "#FFFFFF", "sunk": "#E9E7E0", "line": "#E3E1DA", "control": "#CFCBC1", "ink": "#1B211E", "ink2": "#5A645F", "disabled": "#8A918D", "primary": "#2D5C49", "primaryHover": "#234A3A", "primaryPressed": "#1E4134", "selected": "#DCE7E0", "ok": "#2D7A4F", "info": "#2F5E9E", "warn": "#8A5E0A", "danger": "#B13A26",
               "toast": { "ok": ["#EAF1EC", "#1E4134"], "info": ["#EEF1F6", "#1F3B63"], "warn": ["#FBF1DF", "#6B4A07"], "error": ["#FBEDEA", "#8E2F1F"] } },
    "calibrate": { "bars": ["#FFFFFF", "#FFFF00", "#00FFFF", "#00FF00", "#FF00FF", "#FF0000", "#0000FF", "#000000"], "gray": "11 steps, 0–255 step 25.5" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 56, "9": 64 },
  "radius": { "sm": 8, "md": 10, "card": 12, "displayCard": [14, 20], "pill": 999 },
  "border": { "default": "1px solid ui.line", "current": "2px solid cream.ink", "focusRing": "0 0 0 2px <bg>, 0 0 0 4px #1B211E" },
  "overlay": { "openaiVeil": { "color": "mint.bg", "default": 0.25, "range": [0, 1] }, "claudeVeil": 0.12, "previewShadow": "0 1px 2px rgba(0,0,0,.12), 0 8px 24px rgba(0,0,0,.10)" },
  "grid": {
    "landscape": { "size": [1280, 720], "margin": { "x": 64, "top": 48, "bottom": 44 }, "columns": 12, "gutter": 24, "dataZoneSubscriptions": [48, 940] },
    "portrait":  { "size": [720, 1280], "margin": { "x": 48, "top": [52, 64], "bottom": 56 }, "columns": 6, "gutter": 24 },
    "console": { "nav": 248, "panel": [340, 400], "breakpoints": { "wide": 1280, "medium": 1024, "small": 768, "phone": 390 } }
  },
  "status": {
    "live":    { "icon": "filled-dot",     "text": "实时" },
    "stale":   { "icon": "hollow-dot",     "text": "旧数据 · HH:mm" },
    "unknown": { "icon": "dashed-circle",  "text": "未知 / 未接入", "value": "—" },
    "partial": { "icon": "half-circle",    "text": "部分来源失败" },
    "out":     { "icon": "slashed-circle", "text": "耗尽", "bar": "hatch" },
    "low":     { "rule": "remaining <= 1%", "text": "低额度" },
    "waiting": { "text": "等待更新", "rule": "reset passed, no fresh data: no refill, no negative countdown" }
  },
  "motion": { "toastMs": 4000, "subCarouselS": 15, "detailPageS": 15, "reducedMotion": "static frame, 2s crossfade, brightness change < 10%/s" }
}
